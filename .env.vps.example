# Copy to .env on the VPS and fill in the secrets.
# DB_PASSWORD is only for the bundled Postgres container (pick anything strong).
# The app always uses the bundled DB via docker-compose.prod.yml override.

# --- bundled postgres (compose substitutes this into DATABASE_URL) ---
DB_PASSWORD=change-me-to-something-strong

# --- app ---
# DATABASE_URL is overridden by docker-compose.prod.yml; kept here for prisma CLI use.
DATABASE_URL=postgresql://donprod:${DB_PASSWORD}@db:5432/donprod?schema=public
AUTH_SECRET=generate-with-openssl-rand-base64-32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
